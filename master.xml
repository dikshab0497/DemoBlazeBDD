<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Master Suite" verbose="1">

    <listeners>
        <listener class-name="utilities.RetryListener"/>
    </listeners>

    <!-- ✅ Block 1: Regular TestNG Classes -->
    <test thread-count="5" name="Web Tests">
        <parameter name="os" value="Windows"/>
        <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="Master"/>
            </run>
        </groups>
        <classes>
            <class name="testCases.TC002_CheckOutFunct"/>
        </classes>
    </test>

    <!-- ✅ Block 2: Cucumber TestNG Runner -->
    <test name="BDD Tests">
        <classes>
            <class name="runner.TestNGRunner"/>
        </classes>
    </test>

</suite>